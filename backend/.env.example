# ---- Server ----
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ---- MongoDB (local or Atlas) ----
MONGODB_URI=mongodb://127.0.0.1:27017/ai-business-analyzer

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Any current Claude model string works. Sonnet is the best cost/quality fit here.
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Apify ----
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxx
# Country for Google results (lowercase ISO code): in, us, gb ...
APIFY_COUNTRY=in
# How many competitor websites to crawl in depth (each costs Apify credits)
MAX_COMPETITORS_TO_CRAWL=6

# ---- Publishing (optional) ----
# Paste a Make.com / Zapier / n8n webhook URL. "Publish" sends the post there,
# and your scenario posts it to Instagram / LinkedIn / X.
PUBLISH_WEBHOOK_URL=
